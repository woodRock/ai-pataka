%# A soft, irregular "blob" (like the example poster) used to frame photos.
%# #1 = centre, #2 = radius
\newcommand{\blobpath}[2]{%
  plot[smooth cycle, tension=0.75] coordinates {
    ($#1+(0:1.00*#2)$) ($#1+(55:0.92*#2)$) ($#1+(110:1.05*#2)$)
    ($#1+(170:0.90*#2)$) ($#1+(230:1.02*#2)$) ($#1+(295:0.88*#2)$)}}

%# \photoblob{centre}{radius}{image path or empty}{initials}
\newcommand{\photoblob}[4]{%
  \begin{scope}
    \clip \blobpath{#1}{#2};
    \fill[cream!60] ($#1-(1.2*#2,1.2*#2)$) rectangle ($#1+(1.2*#2,1.2*#2)$);
    \if\relax\detokenize{#3}\relax
      \node[text=navy, font=\titlefont\bfseries\fontsize{44}{44}\selectfont] at #1 {#4};
    \else
      \pgfmathsetlengthmacro{\blobd}{2.3*#2*1mm}%
      \node[inner sep=0] at #1 {\includegraphics[width=\blobd, height=\blobd, keepaspectratio=false]{#3}};
    \fi
  \end{scope}
  \draw[line width=1.2mm, brandred] \blobpath{#1}{#2};}

%# One decorative tile of the strip, colours echo the logo.
%# \tile{x}{y}{style 0-5}
\newcommand{\tile}[3]{%
  \pgfmathtruncatemacro{\s}{#3}%
  \begin{scope}[shift={(#1,#2)}]
    \ifcase\s
      \fill[navy] (0,0) rectangle (1,1); \fill[cream] (0,0) -- (1,0) -- (0,1) -- cycle;
    \or
      \fill[brandred] (0,0) rectangle (1,1); \fill[cream] (0.5,0.5) circle (0.32);
    \or
      \fill[cream] (0,0) rectangle (1,1);
      \fill[navy] (0,0.15) -- (0.5,0.5) -- (1,0.15) -- (1,0.4) -- (0.5,0.75) -- (0,0.4) -- cycle;
    \or
      \fill[navy] (0,0) rectangle (1,1); \fill[brandred] (0,0) arc (180:0:0.5) -- cycle;
    \or
      \fill[cream] (0,0) rectangle (1,1); \fill[brandred] (0.5,1) -- (1,0) -- (0,0) -- cycle;
      \fill[navy] (0.5,0.33) -- (0.75,0) -- (0.25,0) -- cycle;
    \or
      \fill[brandred] (0,0) rectangle (1,1);
      \draw[cream, line width=0.9mm] (0.5,0.5) circle (0.12) (0.5,0.5) circle (0.3);
    \fi
  \end{scope}}

